# Copy to .env.development.local (used by `npm run dev` only).
# Never put the agent id in .env or .env.local: `npm run build:hud` refuses to run
# when it is set, so it can't be baked into the public web/ai/voice.js.
# The HUD reads it at runtime instead: open the HUD once with ?agent=<id>.

# Public ElevenLabs Agent ID (not an API key)
VITE_ELEVENLABS_AGENT_ID=

# mock or official
VITE_MISSION_DATA_SOURCE=mock
